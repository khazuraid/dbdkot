# App
NEXT_PUBLIC_APP_NAME=WALI-EPI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://wali_epi:wali_epi_password@localhost:5432/wali_epi_db

# Auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set true behind reverse proxy (Coolify/Traefik/Nginx/Cloudflare)
TRUST_PROXY=false

# First administrator, created with `npm run db:seed-admin` after migrating.
# Safe to re-run: an existing account is promoted, not duplicated.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# PII at rest (C5). Generate both with:
#   openssl rand -base64 32   -> PII_ENCRYPTION_KEY (must be 32 bytes, base64)
#   openssl rand -hex 32      -> PII_HASH_KEY
# Rotating these makes existing ciphertext/NIK hashes unreadable.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# Queue / Worker (BullMQ)
REDIS_URL=redis://localhost:6379

# WhatsApp Gateway (OpenWA sidecar or external webhook)
# Comma-separated internal origins allowed past SSRF guard (e.g. http://openwa:2785 or http://localhost:2785)
WHATSAPP_ALLOWED_INTERNAL_ORIGINS=http://openwa:2785
# Optional env overrides (leave blank to manage via /pengaturan -> WhatsApp)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SESSION_ID=
DINKES_ALERT_PHONE=

# OpenWA sidecar tuning (compose.yaml / compose.coolify.yaml)
OPENWA_PORT=2785
OPENWA_ENGINE_TYPE=baileys
OPENWA_AUTO_START_SESSIONS=true
OPENWA_CSP_UPGRADE_INSECURE_REQUESTS=false
OPENWA_SEND_PACING_ENABLED=true
OPENWA_SIMULATE_TYPING=true

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=wali-epi
S3_REGION=us-east-1
