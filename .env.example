# App
NEXT_PUBLIC_APP_NAME=WALI-EPI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://wali_epi:wali_epi_password@localhost:5432/wali_epi_db

# Auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First administrator, created with `npm run db:seed-admin` after migrating.
# Safe to re-run: an existing account is promoted, not duplicated.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# PII at rest (C5). Generate both with:
#   openssl rand -base64 32   -> PII_ENCRYPTION_KEY (must be 32 bytes, base64)
#   openssl rand -hex 32      -> PII_HASH_KEY
# Rotating these makes existing ciphertext/NIK hashes unreadable.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=wali-epi
S3_REGION=us-east-1
