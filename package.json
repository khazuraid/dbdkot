{
    "name": "wali-epi",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "worker": "tsx --tsconfig tsconfig.worker.json src/worker/index.ts",
        "worker:dev": "tsx watch --tsconfig tsconfig.worker.json src/worker/index.ts",
        "db:seed-admin": "tsx --env-file-if-exists=.env --tsconfig tsconfig.worker.json src/scripts/seed-admin.ts",
        "docker:up": "docker compose up -d --build --remove-orphans && docker image prune -f"
    },
    "dependencies": {
